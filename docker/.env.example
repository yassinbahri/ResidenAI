# Copy to docker/.env (never commit the real file).
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"

ADMIN_TOKEN=
SCHEDULER_INTERVAL_SECONDS=900

# Only needed if the frontend is deployed at a different origin than the
# API (e.g. a real domain on a VPS) - defaults are fine for local use.
DASHBOARD_ORIGINS=["http://localhost:5174"]
VITE_API_BASE_URL=http://localhost:8100
